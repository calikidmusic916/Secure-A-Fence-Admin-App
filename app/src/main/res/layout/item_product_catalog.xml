<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Product Picture -->
        <ImageView
            android:id="@+id/ivCatalogImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/banner"
            android:contentDescription="Product Image"/>

        <!-- Text Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCatalogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvCatalogPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$65.00 / unit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_blue_dark"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvCatalogStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="In Stock: 150 units"
                android:textSize="12sp"
                android:textColor="@android:color/holo_green_dark"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvCatalogDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heavy-duty perimeter protection"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Quantity / Add to Cart Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="-"
                    android:padding="0dp"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvItemCartQty"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <Button
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="+"
                    android:padding="0dp"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Add to Cart"
                android:textSize="10sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
