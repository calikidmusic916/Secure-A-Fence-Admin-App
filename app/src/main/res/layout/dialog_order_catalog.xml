<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvCatalogHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛒 Equipment Catalog &amp; Order Station"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp"/>

    <!-- Order Type Selector -->
    <RadioGroup
        android:id="@+id/rgOrderType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rbPurchaseOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛒 Purchase (Sale)"
            android:checked="true"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <RadioButton
            android:id="@+id/rbRentalOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔑 Monthly Rental"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </RadioGroup>

    <!-- Products Catalog List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCatalogProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"/>

    <!-- Bottom Cart Summary Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E3F2FD"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartItemCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 Cart: 0 items"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvCartTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: $0.00"
                android:textSize="13sp"
                android:textColor="@android:color/holo_blue_dark"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckoutCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout ➔"
            android:textSize="13sp"/>

    </LinearLayout>
</LinearLayout>
