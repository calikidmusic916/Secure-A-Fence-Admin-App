<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Title & Edit Toggle Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDeliveryDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚚 Dispatch Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <Button
                android:id="@+id/btnEnableEditing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Edit"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeliveryOrderIdAndType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order #ORD-101 | Type: Delivery"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="12dp"/>

        <!-- Section 1: Customer Contact Information (Read-Only) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Customer Contact Details (Read-Only)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvCustomerNameAndCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Client: John Doe (Acme Construction)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/tvCustomerPhoneAndEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone: (279) 261-3890 | Email: sales@acme.com"
                android:textSize="13sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="2dp"/>

            <Button
                android:id="@+id/btnCallCustomer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📞 Call Client"
                android:textSize="11sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Section 2: Driver & Dispatch Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚚 Driver &amp; Transport Info"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driver / Fleet Truck Name"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:enabled="false"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etDispatchDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Dispatch Date (YYYY-MM-DD)"
                android:textSize="13sp"
                android:enabled="false"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/etDestinationAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Destination Address"
                android:inputType="textPostalAddress"
                android:textSize="13sp"
                android:enabled="false"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 3: Status & Time Tracking -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Delivery / Pickup Status &amp; Time"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: "
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/spDeliveryStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimeInputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Estimated Arrival Time (ETA):"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="2dp"/>

        <EditText
            android:id="@+id/etEtaOrPickupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 10:30 AM or 25 mins or 2:00 PM Pickup"
            android:textSize="14sp"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 4: Notes & Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Pickup &amp; Delivery Access Notes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDeliveryNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gate codes, special drop-off or pickup instructions"
            android:inputType="textMultiLine"
            android:lines="2"
            android:textSize="13sp"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 5: Proof Photo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Delivery / Pickup Proof Photo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/btnUploadProofPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📸 Snap / Upload Proof Photo (0 Attached)"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 6: Actual Delivered Quantities -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Delivered Item Quantities"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/llDeliveredItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 7: Tax & In-Person Discount Adjustments -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵 Tax &amp; In-Person Discounts"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <CheckBox
            android:id="@+id/cbIsTaxable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taxable Order (8% CA Sales Tax)"
            android:checked="true"
            android:textSize="13sp"
            android:enabled="false"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etDiscountAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="In-Person Discount ($)"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:enabled="false"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/etFinalPriceOverride"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Final Price Override ($)"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdjustedTotalPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Adjusted Total: $0.00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="12dp"/>

        <!-- Actions -->
        <Button
            android:id="@+id/btnSaveDeliveryChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Dispatch Updates"
            android:textSize="13sp"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCompleteDeliveryAndInvoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✅ Complete &amp; Issue Invoice"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnOpenGpsMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 GPS Map"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelDelivery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚫 Cancel Delivery"
                android:textSize="11sp"
                android:backgroundTint="@android:color/holo_orange_dark"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnDeleteDelivery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ Delete Record"
                android:textSize="11sp"
                android:backgroundTint="@android:color/holo_red_dark"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
