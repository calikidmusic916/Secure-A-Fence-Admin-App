<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvInvoiceDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 Invoice &amp; Order Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvInvoiceStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Order Status: Processing (Invoice Pending Delivery)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="12dp"/>

        <!-- Section 1: Customer Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Customer &amp; Billing Details"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etInvoiceCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Customer Name"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etInvoiceCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Company Name"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etInvoicePhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Phone Number"
                android:inputType="phone"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/etInvoiceEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:textSize="14sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etInvoiceDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Delivery / Jobsite Address"
            android:inputType="textPostalAddress"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 2: Order Items & Quantities -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Order Line Items &amp; Quantities"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:id="@+id/llInvoiceItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 3: Financial Summary & Tax / Discount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💵 Financial Breakdown &amp; Discounts"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <CheckBox
            android:id="@+id/cbInvoiceTaxable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taxable Order (8% CA Sales Tax)"
            android:checked="true"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etInvoiceDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="In-Person Discount / Price Adjustment ($)"
            android:inputType="numberDecimal"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvInvoiceGrandTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Grand Total: $0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 4: Payment Status & Method -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳 Payment Method &amp; Status"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Status: "
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"/>

            <Spinner
                android:id="@+id/spPaymentStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Method: "
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"/>

            <Spinner
                android:id="@+id/spPaymentMethod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnSaveInvoiceChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Invoice Changes"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPrintPdfInvoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖨️ Print PDF"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnMarkInvoicePaid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💳 Mark Paid"
                android:textSize="11sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnDeleteInvoiceRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑️ Delete Invoice / Order"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
