<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvCustomerDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Customer Account Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp"/>

        <!-- Section 1: Customer Profile -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Account Info &amp; Login Credentials"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etCustomerCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Company Name (Optional)"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etCustomerPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Phone Number"
                android:inputType="phone"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/etCustomerEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Email (Username)"
                android:inputType="textEmailAddress"
                android:textSize="14sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etCustomerPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Set Account Password (for login)"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etBusinessAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Business / Billing Address"
            android:inputType="textPostalAddress"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role: "
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp"/>

            <Spinner
                android:id="@+id/spCustomerRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>

            <CheckBox
                android:id="@+id/cbCustomerTaxable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taxable (8%)"
                android:checked="true"
                android:textSize="13sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 2: Financial Standing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Financial Account Balance"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvAccountBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Balance: $0.00 (Current)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 3: Active Rentals & Return Dates -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Active Rentals &amp; Return Dates"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCustomerRentalsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active rentals deployed."
            android:textSize="13sp"
            android:textColor="@android:color/black"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 4: Jobsites -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Jobsites &amp; Delivery Locations"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCustomerJobsitesSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 jobsites registered."
            android:textSize="13sp"
            android:textColor="@android:color/black"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnManageJobsites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Manage Customer Jobsites"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnSaveCustomerChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Customer Profile Changes"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDeleteCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑️ Delete Customer Account"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
