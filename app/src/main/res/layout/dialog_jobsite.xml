<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Jobsite Location Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp"/>

        <!-- Section 1: Location -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Jobsite Name &amp; Physical Address"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jobsite Name (e.g. Tower B / Gate 2)"
            android:inputType="textCapWords"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jobsite Physical Address"
            android:inputType="textPostalAddress"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 2: Contact Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 On-Site Contact Person"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Site Contact Person Name"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_contact_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Site Contact Phone Number"
            android:inputType="phone"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="8dp"/>

        <!-- Section 3: Delivery Distance & Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Gate Instructions &amp; Yard Distance"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Special Delivery / Gate Access Instructions"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_jobsite_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Delivery Distance from Yard (Miles)"
            android:inputType="numberDecimal"
            android:textSize="14sp"/>

    </LinearLayout>
</ScrollView>
