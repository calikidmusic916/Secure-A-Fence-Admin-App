<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_terminal_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳 Process Credit Card Payment"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_terminal_order_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Order #ORD-101 | Customer: Construction Corp"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <!-- Customer & Amount Inputs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Email Address:"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_stripe_customer_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="customer@construction.com"
            android:inputType="textEmailAddress"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description / Notes:"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_stripe_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Temporary Fence Panel Rental Charge"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Charge Amount ($ USD):"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_stripe_charge_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="150.00"
            android:inputType="numberDecimal"
            android:textColor="#0284C7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Custom Stripe Card Input Fields -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="🔒 Credit Card Details (Stripe Secured):"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/et_card_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Card Number (e.g. 4242 4242 4242 4242)"
                android:inputType="number"
                android:maxLength="19"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_card_expiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:hint="MM/YY (e.g. 12/28)"
                    android:inputType="text"
                    android:maxLength="5"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_card_cvc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:hint="CVC (e.g. 123)"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_card_zip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:hint="ZIP (95814)"
                    android:inputType="number"
                    android:maxLength="10"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tax Breakdown Summary -->
        <TextView
            android:id="@+id/tv_stripe_tax_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#EFF6FF"
            android:padding="8dp"
            android:text="Subtotal: $138.89 + Sacramento Sales Tax (8%): $11.11 = Total: $150.00"
            android:textColor="#1E40AF"
            android:textSize="11sp" />

        <!-- Recurring Rental CheckBox -->
        <CheckBox
            android:id="@+id/cb_recurring_rental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Recurring Monthly Rental Auto-Billing"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Progress Spinner -->
        <ProgressBar
            android:id="@+id/progress_stripe_charge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_process_stripe_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#059669"
            android:paddingVertical="12dp"
            android:text="⚡ Process Card Payment with Stripe"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
